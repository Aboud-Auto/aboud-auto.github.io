rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function email() {
      return request.auth.token.email.lower();
    }
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function isOwner() {
      return signedIn() && email() in ['diaakhan84@gmail.com', 'yousefabod10@gmail.com'];
    }
    // المطور: هو بس اللي يوقف البرنامج ويشغّله، وبيفضل يدخل وهو متوقف
    function isDev() {
      return signedIn() && email() == 'yousefabod10@gmail.com';
    }
    function suspended() {
      return exists(/databases/$(database)/documents/config/app) && get(/databases/$(database)/documents/config/app).data.off == true;
    }
    function member() {
      return get(/databases/$(database)/documents/members/$(email())).data;
    }
    function isMember() {
      return signedIn() && exists(/databases/$(database)/documents/members/$(email()));
    }
    function canRead() {
      return isDev() || (!suspended() && (isOwner() || isMember()));
    }
    function canWrite() {
      return isDev() || (!suspended() && (isOwner() || (isMember() && member().role == 'acc')));
    }
    match /members/{id} {
      allow read: if isOwner() || (signedIn() && id == email());
      allow write: if isDev() || (isOwner() && !suspended());
    }
    match /config/{id} {
      allow read: if signedIn();
      allow write: if isDev();
    }
    match /customers/{id} {
      allow read: if canRead();
      allow write: if canWrite();
    }
    match /moves/{id} {
      allow read: if canRead();
      allow write: if canWrite();
    }
    match /items/{id} {
      allow read: if canRead();
      allow write: if canWrite();
    }
    match /invoices/{id} {
      allow read: if canRead();
      allow write: if canWrite();
    }
  }
}
